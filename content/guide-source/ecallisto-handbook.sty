\setkomafont{section}{\Large\sffamily\bfseries\color{accentdark}}
\setkomafont{subsection}{\large\sffamily\bfseries\color{accentdark}}
\setkomafont{subsubsection}{\normalsize\sffamily\bfseries\color{accentdark}}
\setkomafont{paragraph}{\normalsize\sffamily\bfseries\color{accentdark}}
\setkomafont{descriptionlabel}{\sffamily\bfseries\color{accentdark}}
\setkomafont{part}{\Huge\sffamily\bfseries\color{accentdark}}
\setkomafont{partnumber}{\LARGE\sffamily\color{accent}}

\makeatletter
\renewcommand*{\chapterformat}{%
  {\color{accent}\fontsize{56}{56}\selectfont\sffamily\bfseries\thechapter}}
\renewcommand*{\chapterlinesformat}[3]{%
  \def\@ecallisto@num{#2}%
  \ifx\@ecallisto@num\@empty\else
    {\raggedleft #2\par}\nobreak\vspace{2pt}%
  \fi
  {\color{accent}\rule{\linewidth}{1.4pt}}\par\nobreak\vspace{8pt}%
  {\raggedright #3\par}%
}
\makeatother
\RedeclareSectionCommand[beforeskip=-0pt, afterskip=1.8\baselineskip]{chapter}
\RedeclareSectionCommand[beforeskip=-1.6\baselineskip plus -0.4\baselineskip minus -0.2\baselineskip,
  afterskip=0.5\baselineskip plus 0.1\baselineskip]{section}
\RedeclareSectionCommand[beforeskip=-1.2\baselineskip plus -0.3\baselineskip minus -0.2\baselineskip,
  afterskip=0.35\baselineskip plus 0.1\baselineskip]{subsection}
\RedeclareSectionCommand[beforeskip=-1.0\baselineskip plus -0.2\baselineskip minus -0.1\baselineskip,
  afterskip=0.25\baselineskip plus 0.1\baselineskip]{subsubsection}

\RequirePackage[automark,headsepline=0.4pt]{scrlayer-scrpage}
