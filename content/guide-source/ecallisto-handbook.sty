\automark[section]{chapter}
\ihead{\headmark}
\ohead{\pagemark}
\ofoot[\pagemark]{}
\setkomafont{pagehead}{\small\sffamily\color{accentdark}}
\setkomafont{pagenumber}{\small\sffamily\bfseries\color{accent}}
\setkomafont{pageheadfoot}{\small\sffamily}
\renewcommand*{\chaptermarkformat}{\thechapter\enskip}
\renewcommand*{\sectionmarkformat}{\thesection\enskip}

% Wider page-number box in the table of contents
\makeatletter\renewcommand*{\@pnumwidth}{2.4em}\makeatother

% Table of contents in sans for entries of part/chapter level
\setkomafont{chapterentry}{\sffamily\bfseries\color{accentdark}}
\setkomafont{partentry}{\sffamily\bfseries\large\color{accent}}

% ---------------------------------------------------------------------------
% Interface markup
% ---------------------------------------------------------------------------
% \gui{Label}              a button, field, check box, tab or window label
% \menu{File > Export As}  a menu path
% \kbd{Ctrl+S}             a keyboard shortcut
% \file{name.efaproj}      a file name, extension or folder (breakable)
\newcommand{\gui}[1]{\textsf{#1}}
\newcommand{\menusep}{\nobreak\hspace{0.2em}\textcolor{accent}{\ensuremath{\rightarrow}}\hspace{0.2em}\allowbreak}
\ExplSyntaxOn
\seq_new:N \l__ecallisto_menu_seq
\NewDocumentCommand{\menu}{m}{
  \seq_set_split:Nnn \l__ecallisto_menu_seq { > } { #1 }
  \textsf{ \seq_use:Nn \l__ecallisto_menu_seq { \menusep } }
}
\ExplSyntaxOff
\newtcbox{\kbd}{on line, enhanced, boxsep=0pt, left=2.2pt, right=2.2pt,
  top=1.2pt, bottom=1.2pt, colback=black!4, colframe=black!45,
  boxrule=0.45pt, arc=1.6pt, fontupper=\sffamily\footnotesize}
\RequirePackage{url}
\DeclareUrlCommand\file{\urlstyle{tt}}
\Urlmuskip=0mu plus 2mu

\newcommand{\Rsun}{\ensuremath{R_\odot}}
\newcommand{\appname}{e-CALLISTO FITS Analyzer}
\newcommand{\appversion}{3.2.0}
\newcommand{\thead}[1]{\textsf{\bfseries\small #1}}
\newcommand{\callout}[1]{\tikz[baseline=(c.base)]\node[circle, draw=cautionc,
  line width=0.8pt, text=cautionc, inner sep=0.8pt, minimum size=1.15em,
  font=\sffamily\bfseries\scriptsize] (c) {#1};}

% ---------------------------------------------------------------------------
% Admonitions
% ---------------------------------------------------------------------------
\tcbset{ecallistobox/.style={enhanced, breakable, boxrule=0pt, leftrule=2.6pt,
  arc=0pt, outer arc=0pt, left=9pt, right=9pt, top=5pt, bottom=5pt,
  before skip=8pt, after skip=8pt, fontupper=\small}}
\newtcolorbox{note}[1][Note]{ecallistobox, colback=accent!5, colframe=accent,
  before upper={\textsf{\textbf{\textcolor{accent}{#1.}}}\enspace}}
\newtcolorbox{tip}[1][Tip]{ecallistobox, colback=tipc!6, colframe=tipc,
  before upper={\textsf{\textbf{\textcolor{tipc}{#1.}}}\enspace}}
\newtcolorbox{caution}[1][Caution]{ecallistobox, colback=cautionc!5, colframe=cautionc,
  before upper={\textsf{\textbf{\textcolor{cautionc}{#1.}}}\enspace}}
\newtcolorbox{background}[1][Background]{ecallistobox, colback=scic!5, colframe=scic,
  colbacktitle=scic!12, coltitle=scic, fonttitle=\sffamily\bfseries\small,
  toptitle=2pt, bottomtitle=2pt, titlerule=0pt, title={#1}}

% Numbered procedure steps
\newlist{steps}{enumerate}{1}
\setlist[steps]{label=\textsf{\textbf{\textcolor{accent}{\arabic*}}}, leftmargin=1.9em, itemsep=3pt}
\newcommand{\procedure}[1]{\par\medskip\noindent{\sffamily\bfseries\color{accentdark}#1}\par\nobreak\smallskip}

% ---------------------------------------------------------------------------
% Screenshots with automatic placeholders
% ---------------------------------------------------------------------------
% \screenshot[width]{folder/name}{Caption}{fig:label}{What to capture}
% If figures/folder/name.png exists it is included; otherwise a framed
% placeholder shows the expected file name and capture instructions.
\newlength{\ecallistophw}
\newtcolorbox{placeholderbox}{enhanced, width=\ecallistophw, colback=placeholderbg,
  colframe=rulegray, boxrule=0.8pt, arc=2pt,
  left=10pt, right=10pt, top=10pt, bottom=10pt, halign=center, valign=center,
  height from={0.42\ecallistophw} to {0.9\textheight}, fontupper=\small\sffamily}
\newcommand{\placeholder}[3][\linewidth]{%
  \setlength{\ecallistophw}{#1}%
  \begin{placeholderbox}%
    {\color{accent}\large\textbf{Screenshot placeholder}}\par\smallskip
    {\footnotesize\ttfamily figures/\detokenize{#2}.png}\par\medskip
    {\color{black!70}\footnotesize #3\par}%
  \end{placeholderbox}}
\newcommand{\screenshot}[5][\linewidth]{%
  \begin{figure}[!htbp]
    \centering
    \IfFileExists{figures/#2.png}{%
      \includegraphics[width=#1,height=0.70\textheight,keepaspectratio]{figures/#2.png}%
    }{%
      \placeholder[#1]{#2}{#5}%
    }%
    \caption{#3}\label{#4}
  \end{figure}}

% Index group headings (used by index.ist)
\newcommand{\indexgroup}[1]{\par\bigskip{\sffamily\bfseries\large\color{accent}#1}\par\smallskip}

