%% ecallisto-handbook.sty
%% Layout and markup for the e-CALLISTO FITS Analyzer User Guide.
%% Compile with pdfLaTeX + Biber + MakeIndex (the Overleaf default toolchain).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ecallisto-handbook}[2026/10/05 v1.0 e-CALLISTO FITS Analyzer handbook style]

% ---------------------------------------------------------------------------
% Fonts: Libertinus Serif (text), Libertinus Sans (headings, interface
% labels), Libertinus Math, and Inconsolata for file names and code.
% ---------------------------------------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[english]{babel}
\RequirePackage[mono=false]{libertinus}
\RequirePackage{libertinust1math}
\RequirePackage[varqu,varl,scaled=0.92]{zi4}
\RequirePackage{textcomp}
\RequirePackage[protrusion=true,expansion=true]{microtype}

% Unicode characters that appear in interface labels
\RequirePackage{newunicodechar}
\newunicodechar{◀}{\ensuremath{\blacktriangleleft}}
\newunicodechar{▶}{\ensuremath{\blacktriangleright}}
\newunicodechar{☉}{\ensuremath{\odot}}
\newunicodechar{↗}{\ensuremath{\nearrow}}
\newunicodechar{α}{\ensuremath{\alpha}}
\newunicodechar{κ}{\ensuremath{\kappa}}
\newunicodechar{β}{\ensuremath{\beta}}
\newunicodechar{ε}{\ensuremath{\varepsilon}}
\newunicodechar{σ}{\ensuremath{\sigma}}
\newunicodechar{≤}{\ensuremath{\leq}}
\newunicodechar{≥}{\ensuremath{\geq}}
\newunicodechar{′}{\ensuremath{'}}
\newunicodechar{″}{\ensuremath{''}}
